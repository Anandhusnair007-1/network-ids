# Copy to .env, fill in, and keep it out of git.
# API: comma-separated keys. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
IDS_API_KEYS=
IDS_RATE_LIMIT_PER_MIN=120
# Only for local development. The API refuses to start without keys otherwise.
IDS_API_ALLOW_ANON=false
IDS_API_DOCS=false
IDS_METRICS_PUBLIC=false

# Alert policy: tiered | baseline | balanced | confidence_gated
IDS_POLICY=tiered

# SIEM export (leave blank to disable). Only MEDIUM and above are sent by default.
IDS_WEBHOOK_URL=
IDS_WEBHOOK_SECRET=
IDS_SYSLOG_ADDR=
IDS_SINK_MIN_SEVERITY=MEDIUM

# Dashboard login: SHA-256 hex of the password (preferred)
#   python3 -c "import hashlib,getpass; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
IDS_DASH_PASSWORD_SHA256=

# Model manifest signature: path to the Ed25519 public key (see docs/SECURITY.md)
IDS_MANIFEST_PUBKEY=
